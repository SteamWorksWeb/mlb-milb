# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Force LF for all source files regardless of OS
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.avif binary
*.svg  binary
*.ico  binary
